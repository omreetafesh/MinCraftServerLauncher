<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.TextFlow?>
<?import main.Icon?>

<!--
  Layout:  [ sidebar | header / (page stack + players panel) ]
  Stacked between two light layers (see Effects.java): aurora + cursor glow behind the
  translucent panels, the card spotlight in front.
  All look-and-feel lives in style.css; this file only describes structure.
-->
<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:id="appShell"
           fx:controller="main.LauncherController"
           styleClass="app-root"
           stylesheets="@style.css"
           prefWidth="1240" prefHeight="780">

  <fx:define>
    <ToggleGroup fx:id="navGroup"/>
  </fx:define>

  <Pane fx:id="backLayer"/>

<BorderPane fx:id="rootPane">

  <!-- ═══════════════════════════ SIDEBAR ═══════════════════════════ -->
  <left>
    <VBox fx:id="sidebar" styleClass="sidebar" prefWidth="236" minWidth="236" maxWidth="236">

      <HBox styleClass="brand" onMousePressed="#handleWindowPress" onMouseDragged="#handleWindowDrag">
        <ImageView fx:id="logoView" fitWidth="34" fitHeight="34" preserveRatio="true"/>
        <VBox styleClass="brand-text">
          <Label text="Server Launcher" styleClass="brand-title"/>
          <Label text="Minecraft Java Edition" styleClass="brand-sub"/>
        </VBox>
      </HBox>

      <VBox styleClass="profile-card">
        <Label text="PROFILE" styleClass="caption"/>
        <HBox styleClass="profile-row">
          <ComboBox fx:id="profileCombo" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="profile-combo"/>
          <Button onAction="#handleNewProfile" styleClass="icon-button">
            <graphic><Icon name="plus" size="16"/></graphic>
            <tooltip><Tooltip text="New profile"/></tooltip>
          </Button>
          <Button onAction="#handleDeleteProfile" styleClass="icon-button, icon-button-danger">
            <graphic><Icon name="trash" size="16"/></graphic>
            <tooltip><Tooltip text="Delete this profile"/></tooltip>
          </Button>
        </HBox>
      </VBox>

      <Label text="SERVER" styleClass="nav-caption"/>
      <VBox styleClass="nav">
        <ToggleButton text="Console" userData="console" toggleGroup="$navGroup" onAction="#handleNav"
                      styleClass="nav-item" maxWidth="Infinity" selected="true">
          <graphic><Icon name="console"/></graphic></ToggleButton>
        <ToggleButton text="Chat" userData="chat" toggleGroup="$navGroup" onAction="#handleNav"
                      styleClass="nav-item" maxWidth="Infinity">
          <graphic><Icon name="chat"/></graphic></ToggleButton>
        <ToggleButton text="Whitelist &amp; Bans" userData="access" toggleGroup="$navGroup" onAction="#handleNav"
                      styleClass="nav-item" maxWidth="Infinity">
          <graphic><Icon name="shield"/></graphic></ToggleButton>
        <ToggleButton text="Performance" userData="monitor" toggleGroup="$navGroup" onAction="#handleNav"
                      styleClass="nav-item" maxWidth="Infinity">
          <graphic><Icon name="activity"/></graphic></ToggleButton>
        <ToggleButton text="Player History" userData="history" toggleGroup="$navGroup" onAction="#handleNav"
                      styleClass="nav-item" maxWidth="Infinity">
          <graphic><Icon name="clock"/></graphic></ToggleButton>
        <ToggleButton text="Diagnostics" userData="diagnostics" toggleGroup="$navGroup" onAction="#handleNav"
                      styleClass="nav-item" maxWidth="Infinity">
          <graphic><Icon name="alert"/></graphic></ToggleButton>
      </VBox>

      <Label text="TOOLS" styleClass="nav-caption"/>
      <VBox styleClass="nav">
        <ToggleButton text="Remote Console" userData="rcon" toggleGroup="$navGroup" onAction="#handleNav"
                      styleClass="nav-item" maxWidth="Infinity">
          <graphic><Icon name="plug"/></graphic></ToggleButton>
        <ToggleButton text="Macros" userData="macros" toggleGroup="$navGroup" onAction="#handleNav"
                      styleClass="nav-item" maxWidth="Infinity">
          <graphic><Icon name="zap"/></graphic></ToggleButton>
        <ToggleButton text="Settings" userData="settings" toggleGroup="$navGroup" onAction="#handleNav"
                      styleClass="nav-item" maxWidth="Infinity">
          <graphic><Icon name="settings"/></graphic></ToggleButton>
      </VBox>

      <Region VBox.vgrow="ALWAYS"/>

      <!-- Live PC usage -->
      <VBox styleClass="stats-card">
        <HBox styleClass="stat-row">
          <Icon name="cpu" size="14"/>
          <Label text="CPU" styleClass="stat-name"/>
          <Region HBox.hgrow="ALWAYS"/>
          <Label fx:id="cpuLabel" text="–" styleClass="stat-value"/>
        </HBox>
        <ProgressBar fx:id="cpuBar" progress="0" maxWidth="Infinity" styleClass="stat-bar"/>
        <HBox styleClass="stat-row">
          <Icon name="memory" size="14"/>
          <Label text="RAM" styleClass="stat-name"/>
          <Region HBox.hgrow="ALWAYS"/>
          <Label fx:id="ramLabel" text="–" styleClass="stat-value"/>
        </HBox>
        <ProgressBar fx:id="ramBar" progress="0" maxWidth="Infinity" styleClass="stat-bar"/>
      </VBox>
    </VBox>
  </left>

  <!-- ═══════════════════════════ MAIN ══════════════════════════════ -->
  <center>
    <VBox styleClass="main">

      <!-- Header doubles as the window's title bar (drag to move, double-click to maximize) -->
      <HBox styleClass="header" onMousePressed="#handleWindowPress" onMouseDragged="#handleWindowDrag">
        <VBox styleClass="title-block">
          <Label fx:id="pageTitle" text="Console" styleClass="page-title"/>
          <Label fx:id="pageSubtitle" text="Live server output" styleClass="page-subtitle"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>

        <HBox styleClass="status-group">
          <Label fx:id="statusLabel" text="Offline" styleClass="status-pill, status-offline">
            <graphic><Region styleClass="status-dot"/></graphic>
          </Label>
          <Label fx:id="uptimeLabel" styleClass="uptime"/>
        </HBox>

        <Button fx:id="startButton" text="Start" onAction="#handleStartServer" styleClass="btn, btn-primary" minWidth="-Infinity">
          <graphic><Icon name="play" size="14"/></graphic></Button>
        <Button fx:id="restartButton" text="Restart" onAction="#handleRestartServer" styleClass="btn, btn-secondary" minWidth="-Infinity">
          <graphic><Icon name="restart" size="15"/></graphic></Button>
        <Button fx:id="stopButton" text="Stop" onAction="#handleStopServer" styleClass="btn, btn-danger" minWidth="-Infinity">
          <graphic><Icon name="stop" size="14"/></graphic></Button>

        <HBox styleClass="window-controls">
          <Button onAction="#handleMinimize" styleClass="wc-button"><graphic><Icon name="minimize" size="14"/></graphic></Button>
          <Button onAction="#handleMaximize" styleClass="wc-button"><graphic><Icon name="maximize" size="13"/></graphic></Button>
          <Button onAction="#handleWinClose" styleClass="wc-button, wc-close"><graphic><Icon name="close" size="14"/></graphic></Button>
        </HBox>
      </HBox>

      <HBox styleClass="body" VBox.vgrow="ALWAYS">

        <!-- One page visible at a time; ids match the nav buttons' userData -->
        <StackPane fx:id="pageStack" HBox.hgrow="ALWAYS" styleClass="page-stack">

          <!-- ── Console ─────────────────────────────────────── -->
          <VBox id="console" styleClass="page">
            <VBox styleClass="card, console-card" VBox.vgrow="ALWAYS">
              <HBox styleClass="card-toolbar">
                <HBox styleClass="search-box" HBox.hgrow="ALWAYS">
                  <Icon name="search" size="15"/>
                  <TextField fx:id="searchField" promptText="Filter logs…" HBox.hgrow="ALWAYS" styleClass="bare-field"/>
                </HBox>
                <Button text="Clear" onAction="#handleClearConsole" styleClass="btn, btn-ghost">
                  <graphic><Icon name="eraser" size="15"/></graphic></Button>
              </HBox>
              <ListView fx:id="consoleList" VBox.vgrow="ALWAYS" styleClass="log-list, mono"/>
            </VBox>
            <HBox styleClass="command-bar">
              <Label text="›" styleClass="prompt"/>
              <TextField fx:id="commandInput" promptText="Type a server command and press Enter…"
                         onAction="#handleSendCommand" HBox.hgrow="ALWAYS" styleClass="bare-field, mono"/>
              <Button onAction="#handleSendCommand" styleClass="btn, btn-primary, btn-square">
                <graphic><Icon name="send" size="15"/></graphic></Button>
            </HBox>
          </VBox>

          <!-- ── Chat ────────────────────────────────────────── -->
          <VBox id="chat" styleClass="page" visible="false">
            <VBox styleClass="card" VBox.vgrow="ALWAYS">
              <HBox styleClass="card-header">
                <Label text="Player chat" styleClass="card-title"/>
              </HBox>
              <ListView fx:id="chatList" VBox.vgrow="ALWAYS" styleClass="log-list, mono"/>
            </VBox>
          </VBox>

          <!-- ── Whitelist & Bans ────────────────────────────── -->
          <HBox id="access" styleClass="page, page-row" visible="false">
            <VBox styleClass="card" HBox.hgrow="ALWAYS">
              <HBox styleClass="card-header">
                <Icon name="check" size="16" styleClass="accent-icon"/>
                <Label text="Whitelist" styleClass="card-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button onAction="#loadWhitelist" styleClass="icon-button">
                  <graphic><Icon name="refresh" size="15"/></graphic>
                  <tooltip><Tooltip text="Reload from whitelist.json"/></tooltip></Button>
              </HBox>
              <ListView fx:id="whitelistView" VBox.vgrow="ALWAYS" styleClass="plain-list"/>
              <HBox styleClass="card-footer">
                <TextField fx:id="whitelistAddField" promptText="Player name" HBox.hgrow="ALWAYS"
                           onAction="#handleAddToWhitelist"/>
                <Button text="Add" onAction="#handleAddToWhitelist" styleClass="btn, btn-primary"/>
                <Button text="Remove" onAction="#handleRemoveFromWhitelist" styleClass="btn, btn-ghost"/>
              </HBox>
            </VBox>
            <VBox styleClass="card" HBox.hgrow="ALWAYS">
              <HBox styleClass="card-header">
                <Icon name="ban" size="16" styleClass="danger-icon"/>
                <Label text="Banned players" styleClass="card-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button onAction="#loadBanList" styleClass="icon-button">
                  <graphic><Icon name="refresh" size="15"/></graphic>
                  <tooltip><Tooltip text="Reload from banned-players.json"/></tooltip></Button>
              </HBox>
              <ListView fx:id="banListView" VBox.vgrow="ALWAYS" styleClass="plain-list"/>
              <HBox styleClass="card-footer">
                <TextField fx:id="banAddField" promptText="Player name" HBox.hgrow="ALWAYS" onAction="#handleAddBan"/>
                <Button text="Ban" onAction="#handleAddBan" styleClass="btn, btn-danger"/>
                <Button text="Pardon" onAction="#handlePardon" styleClass="btn, btn-ghost"/>
              </HBox>
            </VBox>
          </HBox>

          <!-- ── Performance ─────────────────────────────────── -->
          <ScrollPane id="monitor" fitToWidth="true" styleClass="page-scroll" visible="false">
            <VBox fx:id="monitorContainer" styleClass="page, monitor-grid"/>
          </ScrollPane>

          <!-- ── Player history ──────────────────────────────── -->
          <VBox id="history" styleClass="page" visible="false">
            <VBox styleClass="card" VBox.vgrow="ALWAYS">
              <HBox styleClass="card-header">
                <Label text="Everyone who has joined" styleClass="card-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="playerStatsStatus" text="Not loaded" styleClass="muted"/>
                <Button text="Refresh" onAction="#refreshPlayerStats" styleClass="btn, btn-ghost">
                  <graphic><Icon name="refresh" size="15"/></graphic></Button>
              </HBox>
              <TableView fx:id="playerStatsTable" VBox.vgrow="ALWAYS" styleClass="data-table">
                <columns>
                  <TableColumn text="Player"     prefWidth="150"/>
                  <TableColumn text="Play time"  prefWidth="110"/>
                  <TableColumn text="Deaths"     prefWidth="80"/>
                  <TableColumn text="Kills"      prefWidth="80"/>
                  <TableColumn text="Distance"   prefWidth="100"/>
                  <TableColumn text="UUID"       prefWidth="260"/>
                </columns>
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
              </TableView>
            </VBox>
          </VBox>

          <!-- ── Diagnostics ─────────────────────────────────── -->
          <VBox id="diagnostics" styleClass="page" visible="false">
            <VBox styleClass="card" VBox.vgrow="ALWAYS">
              <HBox styleClass="card-header">
                <Label text="Detected issues" styleClass="card-title"/>
                <Label text="Common problems spotted in the server log, with how to fix them" styleClass="muted"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Clear" onAction="#clearDiagnostics" styleClass="btn, btn-ghost">
                  <graphic><Icon name="eraser" size="15"/></graphic></Button>
              </HBox>
              <TextArea fx:id="diagnosticsArea" editable="false" wrapText="true" VBox.vgrow="ALWAYS"
                        styleClass="diagnostics-area"
                        promptText="No issues detected yet. Server problems will appear here automatically."/>
            </VBox>
          </VBox>

          <!-- ── Remote console ──────────────────────────────── -->
          <VBox id="rcon" styleClass="page" visible="false">
            <VBox styleClass="card">
              <HBox styleClass="card-header">
                <Label text="Connection" styleClass="card-title"/>
                <Label text="Control a server that runs elsewhere (enable-rcon=true in server.properties)" styleClass="muted"/>
              </HBox>
              <GridPane styleClass="form-grid">
                <columnConstraints>
                  <ColumnConstraints minWidth="80"/>
                  <ColumnConstraints hgrow="ALWAYS"/>
                  <ColumnConstraints minWidth="50"/>
                  <ColumnConstraints minWidth="110" maxWidth="130"/>
                </columnConstraints>
                <Label text="Host"     styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <TextField fx:id="rconHostField" text="localhost" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                <Label text="Port"     styleClass="field-label" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                <TextField fx:id="rconPortField" text="25575" GridPane.columnIndex="3" GridPane.rowIndex="0"/>
                <Label text="Password" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <PasswordField fx:id="rconPasswordField" promptText="rcon.password"
                               GridPane.columnIndex="1" GridPane.rowIndex="1" GridPane.columnSpan="3"/>
              </GridPane>
              <HBox styleClass="card-footer">
                <Button fx:id="rconConnectButton" text="Connect" onAction="#handleRconConnect" styleClass="btn, btn-primary">
                  <graphic><Icon name="plug" size="15"/></graphic></Button>
                <Label fx:id="rconStatusLabel" text="Disconnected" styleClass="status-text, status-text-bad"/>
              </HBox>
            </VBox>
            <VBox styleClass="card" VBox.vgrow="ALWAYS">
              <ListView fx:id="rconOutputList" VBox.vgrow="ALWAYS" styleClass="log-list, mono"/>
              <HBox styleClass="card-footer">
                <TextField fx:id="rconCommandField" promptText="RCON command…" onAction="#handleRconCommand"
                           HBox.hgrow="ALWAYS" styleClass="mono"/>
                <Button onAction="#handleRconCommand" styleClass="btn, btn-primary, btn-square">
                  <graphic><Icon name="send" size="15"/></graphic></Button>
              </HBox>
            </VBox>
          </VBox>

          <!-- ── Macros ──────────────────────────────────────── -->
          <VBox id="macros" styleClass="page" visible="false">
            <VBox styleClass="card" VBox.vgrow="ALWAYS">
              <HBox styleClass="card-header">
                <Label text="Command macros" styleClass="card-title"/>
                <Label text="Save a list of commands and run them all with one click" styleClass="muted"/>
              </HBox>
              <ListView fx:id="macrosList" VBox.vgrow="ALWAYS" styleClass="plain-list"/>
              <HBox styleClass="card-footer">
                <Button text="Run selected" onAction="#handleRunMacro" styleClass="btn, btn-primary">
                  <graphic><Icon name="play" size="13"/></graphic></Button>
                <Button text="New macro" onAction="#handleAddMacro" styleClass="btn, btn-secondary">
                  <graphic><Icon name="plus" size="15"/></graphic></Button>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Delete" onAction="#handleDeleteMacro" styleClass="btn, btn-ghost-danger">
                  <graphic><Icon name="trash" size="15"/></graphic></Button>
              </HBox>
            </VBox>
          </VBox>

          <!-- ── Settings ────────────────────────────────────── -->
          <VBox id="settings" styleClass="page" visible="false">
            <TabPane fx:id="settingsTabs" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS" styleClass="pill-tabs">

              <!-- Server -->
              <Tab text="Server">
                <graphic><Icon name="server" size="15"/></graphic>
                <ScrollPane fitToWidth="true" styleClass="page-scroll">
                  <VBox styleClass="settings-stack">
                    <VBox styleClass="card, setting-card">
                      <Label text="Server folder" styleClass="card-title"/>
                      <Label text="The folder that contains your server JAR and world." styleClass="muted" wrapText="true"/>
                      <HBox styleClass="field-row">
                        <TextField fx:id="serverPathField" promptText="No folder selected" editable="false" HBox.hgrow="ALWAYS"/>
                        <Button text="Browse" onAction="#handleSelectServerDirectory" styleClass="btn, btn-secondary">
                          <graphic><Icon name="folder" size="15"/></graphic></Button>
                        <Button text="Clear" onAction="#handleClearServerDirectory" styleClass="btn, btn-ghost"/>
                      </HBox>
                    </VBox>
                    <VBox styleClass="card, setting-card">
                      <Label text="Server JAR" styleClass="card-title"/>
                      <Label text="File name of the JAR inside the server folder, e.g. paper-26.3-231.jar." styleClass="muted" wrapText="true"/>
                      <HBox styleClass="field-row">
                        <TextField fx:id="serverJarField" promptText="server.jar" HBox.hgrow="ALWAYS"/>
                        <Button text="Reset" onAction="#resetServerJar" styleClass="btn, btn-ghost"/>
                      </HBox>
                    </VBox>
                    <VBox styleClass="card, setting-card, highlight-card">
                      <Label text="Download a server" styleClass="card-title"/>
                      <Label text="Get Paper, Vanilla or Fabric straight into your server folder — checksum-verified." styleClass="muted" wrapText="true"/>
                      <HBox styleClass="field-row">
                        <Button text="Download server JAR…" onAction="#showJarDownloader" styleClass="btn, btn-primary">
                          <graphic><Icon name="download" size="15"/></graphic></Button>
                      </HBox>
                    </VBox>
                  </VBox>
                </ScrollPane>
              </Tab>

              <!-- Performance -->
              <Tab text="Performance">
                <graphic><Icon name="gauge" size="15"/></graphic>
                <ScrollPane fitToWidth="true" styleClass="page-scroll">
                  <VBox styleClass="settings-stack">
                    <VBox styleClass="card, setting-card">
                      <Label text="Memory" styleClass="card-title"/>
                      <Label text="Maximum RAM for the server. 4–8 GB is a good range for modded or busy servers." styleClass="muted" wrapText="true"/>
                      <HBox styleClass="field-row">
                        <TextField fx:id="memoryField" text="2" prefWidth="90" maxWidth="90" styleClass="number-field"/>
                        <Label text="GB" styleClass="unit"/>
                      </HBox>
                    </VBox>
                    <VBox styleClass="card, setting-card">
                      <Label text="Java" styleClass="card-title"/>
                      <Label text="Leave empty to pick the right Java automatically for your server JAR." styleClass="muted" wrapText="true"/>
                      <HBox styleClass="field-row">
                        <TextField fx:id="javaPathField" promptText="Auto-detect" HBox.hgrow="ALWAYS"/>
                        <Button text="Browse" onAction="#handleBrowseJava" styleClass="btn, btn-secondary">
                          <graphic><Icon name="folder" size="15"/></graphic></Button>
                        <Button text="Auto" onAction="#handleAutoJava" styleClass="btn, btn-ghost"/>
                      </HBox>
                      <Label fx:id="javaDetectedLabel" wrapText="true" styleClass="hint"/>
                    </VBox>
                    <VBox styleClass="card, setting-card">
                      <Label text="JVM flags" styleClass="card-title"/>
                      <Label text="Aikar's G1GC flags — production-tuned settings that cut garbage-collection lag spikes." styleClass="muted" wrapText="true"/>
                      <CheckBox fx:id="optimizedFlagsCheck" text="Use Aikar's optimized flags" onAction="#handleOptimizedFlagsToggle"/>
                      <Label styleClass="code-block" wrapText="true" maxWidth="Infinity"
                             text="-XX:+UseG1GC  -XX:+ParallelRefProcEnabled  -XX:MaxGCPauseMillis=200  -XX:G1HeapRegionSize=8M  -XX:G1NewSizePercent=30  -XX:G1MaxNewSizePercent=40  -XX:InitiatingHeapOccupancyPercent=15  +14 more"/>
                    </VBox>
                    <VBox styleClass="card, setting-card">
                      <Label text="Interface effects" styleClass="card-title"/>
                      <Label text="The animated background, the glow that follows your mouse and the card highlights. Turn off to save a little CPU and GPU on slower PCs." styleClass="muted" wrapText="true"/>
                      <CheckBox fx:id="effectsCheck" text="Animated background and cursor glow" onAction="#handleEffectsToggle"/>
                    </VBox>
                  </VBox>
                </ScrollPane>
              </Tab>

              <!-- World config -->
              <Tab text="World">
                <graphic><Icon name="globe" size="15"/></graphic>
                <VBox styleClass="settings-stack" VBox.vgrow="ALWAYS">
                  <HBox styleClass="toolbar">
                    <VBox>
                      <Label text="server.properties" styleClass="card-title"/>
                      <Label text="Changes apply the next time the server starts." styleClass="muted"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <CheckBox fx:id="rawEditToggle" text="Edit as text" onAction="#toggleRawEdit"/>
                    <Button text="Reload" onAction="#handleReloadProperties" styleClass="btn, btn-ghost">
                      <graphic><Icon name="refresh" size="15"/></graphic></Button>
                    <Button text="Save" onAction="#handleSavePropertiesForm" styleClass="btn, btn-primary">
                      <graphic><Icon name="save" size="15"/></graphic></Button>
                  </HBox>
                  <ScrollPane fx:id="propertiesFormScroll" fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="page-scroll">
                    <VBox fx:id="propertiesFormContainer" styleClass="props-form"/>
                  </ScrollPane>
                  <TextArea fx:id="propertiesEditor" visible="false" managed="false" VBox.vgrow="ALWAYS"
                            styleClass="code-area" promptText="# server.properties"/>
                </VBox>
              </Tab>

              <!-- Backups -->
              <Tab text="Backups">
                <graphic><Icon name="archive" size="15"/></graphic>
                <ScrollPane fitToWidth="true" styleClass="page-scroll">
                  <VBox styleClass="settings-stack">
                    <VBox styleClass="card, setting-card">
                      <Label text="Backup folder" styleClass="card-title"/>
                      <Label text="Where world backups are saved. A different drive gives extra protection." styleClass="muted" wrapText="true"/>
                      <HBox styleClass="field-row">
                        <TextField fx:id="backupPathField" promptText="No folder selected" editable="false" HBox.hgrow="ALWAYS"/>
                        <Button text="Browse" onAction="#handleSelectBackupDirectory" styleClass="btn, btn-secondary">
                          <graphic><Icon name="folder" size="15"/></graphic></Button>
                        <Button text="Clear" onAction="#handleClearBackupDirectory" styleClass="btn, btn-ghost"/>
                      </HBox>
                    </VBox>
                    <VBox styleClass="card, setting-card">
                      <Label text="Automatic backups" styleClass="card-title"/>
                      <CheckBox fx:id="autoBackupCheck" text="Back up the world every 24 hours" onAction="#handleBackupToggle"/>
                      <HBox styleClass="field-row">
                        <Label text="Keep the newest" styleClass="field-label"/>
                        <TextField fx:id="maxBackupsField" text="5" prefWidth="64" maxWidth="64" styleClass="number-field"/>
                        <Label text="backups — older ones are deleted" styleClass="muted"/>
                      </HBox>
                      <HBox styleClass="field-row">
                        <Button text="Back up now" onAction="#forceBackup" styleClass="btn, btn-primary">
                          <graphic><Icon name="archive" size="15"/></graphic></Button>
                        <Button text="Open folder" onAction="#openBackupFolder" styleClass="btn, btn-secondary">
                          <graphic><Icon name="folder" size="15"/></graphic></Button>
                      </HBox>
                    </VBox>
                    <VBox styleClass="card, setting-card">
                      <Label text="Restore" styleClass="card-title"/>
                      <Label text="Pick a backup to restore. Your current world is renamed, never deleted." styleClass="muted" wrapText="true"/>
                      <ListView fx:id="backupFilesList" prefHeight="150" styleClass="plain-list, mono"/>
                      <HBox styleClass="field-row">
                        <Button text="Refresh" onAction="#refreshBackupList" styleClass="btn, btn-ghost">
                          <graphic><Icon name="refresh" size="15"/></graphic></Button>
                        <Button text="Restore selected" onAction="#handleRestoreBackup" styleClass="btn, btn-warning">
                          <graphic><Icon name="restart" size="15"/></graphic></Button>
                      </HBox>
                    </VBox>
                  </VBox>
                </ScrollPane>
              </Tab>

              <!-- Automation -->
              <Tab text="Automation">
                <graphic><Icon name="timer" size="15"/></graphic>
                <ScrollPane fitToWidth="true" styleClass="page-scroll">
                  <VBox styleClass="settings-stack">
                    <VBox styleClass="card, setting-card">
                      <Label text="Crash recovery" styleClass="card-title"/>
                      <Label text="Restart the server automatically if it crashes." styleClass="muted" wrapText="true"/>
                      <CheckBox fx:id="crashRestartCheck" text="Auto-restart after a crash" onAction="#handleCrashRestartToggle"/>
                      <HBox styleClass="field-row">
                        <Label text="Wait" styleClass="field-label"/>
                        <TextField fx:id="crashRestartDelayField" text="10" prefWidth="64" maxWidth="64"
                                   styleClass="number-field" onAction="#handleCrashRestartToggle"/>
                        <Label text="seconds before restarting" styleClass="muted"/>
                      </HBox>
                    </VBox>
                    <VBox styleClass="card, setting-card">
                      <Label text="Daily restart" styleClass="card-title"/>
                      <Label text="Players get a 1-minute warning in chat, then the server restarts at the set time." styleClass="muted" wrapText="true"/>
                      <CheckBox fx:id="scheduledRestartCheck" text="Restart every day" onAction="#handleScheduledRestartToggle"/>
                      <HBox styleClass="field-row">
                        <Label text="At" styleClass="field-label"/>
                        <TextField fx:id="scheduledRestartField" text="04:00" prefWidth="80" maxWidth="80"
                                   promptText="HH:mm" styleClass="number-field"/>
                        <Label text="24-hour time, this PC's clock" styleClass="muted"/>
                      </HBox>
                      <Label styleClass="tip" wrapText="true" maxWidth="Infinity"
                             text="Tip: pick a quiet hour such as 04:00. Changes apply immediately — the console shows when the next restart will happen."/>
                    </VBox>
                  </VBox>
                </ScrollPane>
              </Tab>

              <!-- MOTD -->
              <Tab text="MOTD">
                <graphic><Icon name="type" size="15"/></graphic>
                <ScrollPane fitToWidth="true" styleClass="page-scroll">
                  <VBox styleClass="settings-stack">
                    <VBox styleClass="card, setting-card">
                      <Label text="Server description" styleClass="card-title"/>
                      <Label text="Shown under your server's name in the multiplayer list. Click a color or style to insert its code." styleClass="muted" wrapText="true"/>
                      <VBox fx:id="motdPaletteContainer" styleClass="motd-palette"/>
                      <TextArea fx:id="motdRawField" promptText="&amp;6My Minecraft Server&#10;&amp;ePlaying on 26.3"
                                prefRowCount="3" wrapText="true" onKeyReleased="#handleMotdInput" styleClass="mono"/>
                    </VBox>
                    <VBox styleClass="card, setting-card">
                      <Label text="Preview" styleClass="card-title"/>
                      <HBox styleClass="motd-preview-box">
                        <ImageView fx:id="motdIconView" fitWidth="48" fitHeight="48"/>
                        <VBox styleClass="motd-preview-text">
                          <Label text="Minecraft Server" styleClass="motd-server-name"/>
                          <TextFlow fx:id="motdPreview" lineSpacing="2"/>
                        </VBox>
                      </HBox>
                      <HBox styleClass="field-row">
                        <Button text="Apply to server.properties" onAction="#applyMotdToProperties" styleClass="btn, btn-primary">
                          <graphic><Icon name="save" size="15"/></graphic></Button>
                        <Button text="Clear" onAction="#clearMotd" styleClass="btn, btn-ghost"/>
                      </HBox>
                    </VBox>
                  </VBox>
                </ScrollPane>
              </Tab>
            </TabPane>
          </VBox>
        </StackPane>

        <!-- ── Online players ─────────────────────────────────── -->
        <VBox fx:id="playersRail" styleClass="rail" prefWidth="244" minWidth="244" maxWidth="244">
          <HBox styleClass="rail-header">
            <Label text="Online now" styleClass="card-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox fx:id="counterContainer" styleClass="count-pill">
              <Label fx:id="playerCountLabel" text="0" styleClass="count-text"/>
            </HBox>
          </HBox>
          <ListView fx:id="playerList" VBox.vgrow="ALWAYS" styleClass="player-list"/>
        </VBox>
      </HBox>
    </VBox>
  </center>
</BorderPane>

  <Pane fx:id="frontLayer"/>
</StackPane>
