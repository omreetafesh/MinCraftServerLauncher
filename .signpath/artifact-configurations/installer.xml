<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration "installer": signs MinecraftServerLauncher-Setup.exe, uploaded by
  .github/workflows/release.yml (step "Upload the installer for signing"). GitHub artifacts reach
  SignPath as a ZIP with the installer at its root.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="MinecraftServerLauncher-Setup.exe" product-name="Minecraft Server Launcher">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
