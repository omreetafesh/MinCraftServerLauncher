<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration "app": signs the launcher's own .exe inside the app folder that
  .github/workflows/release.yml uploads (step "Upload the launcher for signing"). GitHub artifacts
  reach SignPath as a ZIP whose root is the contents of dist/output/.
  The bundled Java runtime and JavaFX libraries are upstream binaries and stay as they are.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="Minecraft Server Launcher/Minecraft Server Launcher.exe" product-name="Minecraft Server Launcher">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
